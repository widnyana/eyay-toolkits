{
  "description": "Re-announces Design Thinking mode once per session if /dt left it enabled",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/scripts/inject-design-thinking.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
